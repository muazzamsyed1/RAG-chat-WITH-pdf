# ============================================================
# COPY THIS FILE TO .env AND FILL IN REAL VALUES
# NEVER COMMIT .env TO GIT
# ============================================================

# --- Application ---
APP_NAME="RAG Chatbot API"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# --- Database ---
# Dev (SQLite - default):
DATABASE_URL=sqlite+aiosqlite:///./ragchat.db
# Prod (PostgreSQL - uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ragchat

# --- Google Gemini ---
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Upload ---
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_SIZE_MB=20

# --- Vector DB (ChromaDB) ---
CHROMA_PERSIST_DIR=../vector_db/chroma

# --- CORS (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
